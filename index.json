                "api": "=0.1.0-internal.1"
              },
              "main": {
                "browser": "index.js"
              },
              "activationEvents": [
                "onCommand:com.netcatty.market-smoke.version",
                "onView:com.netcatty.market-smoke.panel"
              ],
              "permissions": {
                "required": [
                  "commands",
                  "menus",
                  "views"
                ],
                "optional": []
              },
              "contributes": {
                "commands": [
                  {
                    "id": "com.netcatty.market-smoke.version",
                    "title": {
                      "en": "Acceptance Example: Read Version"
                    }
                  }
                ],
                "menus": [
                  {
                    "command": "com.netcatty.market-smoke.version",
                    "location": "commandPalette",
                    "group": "examples"
                  }
                ],
                "views": [
                  {
                    "id": "com.netcatty.market-smoke.panel",
                    "title": {
                      "en": "Marketplace Acceptance Example"
                    },
                    "location": "modal",
                    "entry": "panel.html"
                  }
                ]
              }
            },
            "artifact": {
              "url": "https://github.com/binaricat/netcatty-plugin-examples/releases/download/market-smoke-v0.1.0/market-smoke-0.1.0.ncpkg",
              "sha256": "d402cab030784c39e3f5a4f84b1c00b97c118dc17d715e057b6eecc5508a6724"
            }
          },
          "distribution": "release",
          "tag": "market-smoke-v0.1.0",
          "withdrawal": null
        }
      ]
    }
  ]
}
