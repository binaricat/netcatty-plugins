            "commit": "a4a08ca6fbf7daa2509e9d1376b93cccbeee2f61",
            "license": "MIT",
            "readme": "plugins/market-smoke/README.md",
            "manifest": {
              "manifestVersion": 1,
              "id": "com.netcatty.market-smoke",
              "name": "market-smoke",
              "displayName": {
                "en": "Marketplace Acceptance Example",
                "zh-CN": "市场验收样例"
              },
              "description": "Visible test example for install and update acceptance. No external data access.",
              "version": "0.1.0",
              "publisher": "netcatty",
